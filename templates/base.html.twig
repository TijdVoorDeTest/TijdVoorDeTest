<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% block sentry_loader %}
    <script
        src="https://js-de.sentry-cdn.com/30cf438bc708c97e6f45c127bed9af96.min.js"
        crossorigin="anonymous"
    ></script>
    {% endblock %}
    <title>
        {% block title %}Tijd voor de test{% endblock title %}
    </title>
    {% block importmap %}{% endblock %}
    {% block head_extra %}{% endblock %}
</head>
<body>
<a class="visually-hidden-focusable" href="#main-content">{{ 'Skip to content'|trans }}</a>
{% block nav %}
{% endblock nav %}
<main id="main-content">
    {% block main %}
        <div class="container">
            {{ include('flashes.html.twig') }}
            {% block body %}
            {% endblock body %}
        </div>
    {% endblock %}
</main>
</body>
</html>
