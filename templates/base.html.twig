<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% set page_title %}{% block page_title %}{% endblock %}{% endset %}
    <title>{% if page_title|trim %}{{ page_title|trim }} | {% endif %}Tijd voor de test{% if git_sha and not git_tag %} ({{ 'Acceptance'|trans }}){% endif %}</title>
    {% block importmap %}{% endblock %}
    {% block head_extra %}{% endblock %}
</head>
<body>
<a class="visually-hidden-focusable" href="#main-content">{{ 'Skip to content'|trans }}</a>
{% block nav %}
{% endblock nav %}
<main id="main-content" tabindex="-1">
    {% block main %}
        <div class="container">
            {{ include('flashes.html.twig') }}
            {% block body %}
            {% endblock body %}
        </div>
    {% endblock %}
</main>
</body>
</html>
