{% if is_granted('IS_AUTHENTICATED') or app.current_route() == 'tvdt_quiz_select_season' %}
    <nav class="quiz-topbar" aria-label="{{ 'Main navigation'|trans }}">
        <a href="{{ path('tvdt_molshoop_index') }}" class="btn btn-outline-secondary btn-sm">
            {{ 'Molehill'|trans }}
        </a>
        {% if is_granted('IS_AUTHENTICATED') %}
            <a href="{{ path('tvdt_login_logout', {target: app.request.pathInfo}) }}" class="btn btn-outline-secondary btn-sm">
                {{ 'Logout'|trans }}
            </a>
        {% endif %}
    </nav>
{% endif %}
