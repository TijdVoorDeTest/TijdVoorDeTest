{% if is_granted('IS_AUTHENTICATED') or app.current_route() == 'tvdt_quiz_select_season' %}
    <nav class="quiz-topbar" aria-label="{{ 'Main navigation'|trans }}">
        <a href="{{ path('tvdt_molshoop_index') }}" class="btn btn-outline-secondary btn-sm">
            {{ 'Molehill'|trans }}
        </a>
        {% if is_granted('IS_AUTHENTICATED') %}
            <form method="post" action="{{ path('tvdt_login_logout', {target: app.request.pathInfo}) }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button type="submit" class="btn btn-outline-secondary btn-sm">{{ 'Logout'|trans }}</button>
            </form>
        {% endif %}
    </nav>
{% endif %}
