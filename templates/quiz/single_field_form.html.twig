{% extends 'quiz/base.html.twig' %}
{% set field = form.children|first %}
{% block page_title %}{{ field.vars.label }}{% endblock %}
{% block nav %}{% if not hide_nav|default(false) %}{{ parent() }}{% endif %}{% endblock %}
{% block body %}
    <div class="quiz-form-narrow">
        {{ form_start(form) }}
        {{ form_label(field) }}
        <div class="quiz-input-group">
            {{ form_widget(field) }}
            <button type="submit" class="quiz-submit-btn" aria-label="{{ 'Submit'|trans }}"></button>
        </div>
        {{ form_errors(field) }}
        {{ form_end(form) }}
    </div>
{% endblock body %}
