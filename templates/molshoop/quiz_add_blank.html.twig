{% extends 'molshoop/base.html.twig' %}

{% block breadcrumbs %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('tvdt_molshoop_index') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('tvdt_molshoop_season', {seasonCode: season.seasonCode}) }}">{{ season.name }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Add blank quiz'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-6 col-12">
            <h2 class="mb-3">{{ t('Add a quiz to {name}', {name: season.name})|trans }}</h2>
            {{ form_start(form) }}
            {{ form_row(form.name) }}
            {{ form_widget(form.save, {attr: {class: 'btn btn-primary'}}) }}
            {{ form_end(form) }}
        </div>
        <div class="col-md-6 col-12">
            {{ include('molshoop/help/quiz_add_blank.html.twig') }}
        </div>
    </div>
{% endblock %}

{% block title %}{{ parent() }}{{ 'Molehill'|trans }}{% endblock %}
