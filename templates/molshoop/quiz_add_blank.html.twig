{% extends 'molshoop/base.html.twig' %}

{% import 'molshoop/partials/breadcrumb.html.twig' as breadcrumb %}

{% block breadcrumbs %}
    {{ breadcrumb.breadcrumb([
        {label: 'Home'|trans, path: path('tvdt_molshoop_index')},
        {label: season.name, path: path('tvdt_molshoop_season', {seasonCode: season.seasonCode})},
        {label: 'Add blank quiz'|trans},
    ]) }}
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-6 col-12">
            <h2 class="mb-3">{{ t('Add a quiz to {name}', {name: season.name})|trans }}</h2>
            {{ form_start(form) }}
            {{ form_row(form.name) }}
            {{ form_widget(form.save, {attr: {class: 'btn btn-primary'}}) }}
            {{ form_end(form) }}
        </div>
        <div class="col-md-6 col-12">
            {{ include('molshoop/help/quiz_add_blank.html.twig') }}
        </div>
    </div>
{% endblock %}

{% block title %}{{ parent() }}{{ 'Molehill'|trans }}{% endblock %}
