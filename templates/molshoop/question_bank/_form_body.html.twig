{% import 'molshoop/partials/answer_row.html.twig' as macros %}

{{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
{{ form_row(form.question) }}
{{ form_row(form.reusable) }}
<fieldset class="mb-3">
    <legend class="form-label">{{ 'Labels'|trans }}</legend>
    {{ macros.label_checkboxes(form.labels) }}
</fieldset>

{{ macros.answer_collection(form.answers) }}

{% if isModal ?? false %}
    {% do form.save.setRendered %}
{% endif %}
{{ form_end(form) }}
{% if isModal ?? false %}
<template data-modal-footer>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
    <button type="submit" class="btn btn-primary">{{ 'Save'|trans }}</button>
</template>
{% endif %}
