<div class="row">
    <div class="col-md-6 col-12">
        <div class="btn-group btn-group-sm mb-3" role="group" aria-label="{{ 'Quiz actions'|trans }}">
            <a class="btn btn-outline-primary"
               href="{{ path('tvdt_molshoop_quiz_add_blank', {seasonCode: season.seasonCode}) }}">{{ 'Add Empty Quiz'|trans }}</a>
            <a class="btn btn-outline-secondary"
               href="{{ path('tvdt_molshoop_quiz_add', {seasonCode: season.seasonCode}) }}">{{ 'Import Quiz from Excel'|trans }}</a>
            <a class="btn btn-outline-secondary"
               href="{{ path('tvdt_molshoop_template') }}">{{ 'Download Template'|trans }}</a>
        </div>
        <div class="list-group mb-3">
            {% for quiz in season.quizzes %}
                <a class="list-group-item list-group-item-action d-flex align-items-center gap-2{% if season.activeQuiz == quiz %} active{% endif %}"
                   href="{{ path('tvdt_molshoop_quiz', {seasonCode: season.seasonCode, quiz: quiz.id}) }}">
                    {{ quiz.name }}
                    <span class="badge text-bg-{{ quiz.status.badgeColour.value }} ms-auto">{{ quiz.status.label|trans }}</span>
                </a>
            {% else %}
                {{ 'No quizzes'|trans }}
            {% endfor %}
        </div>
    </div>
    <div class="col-md-6 col-12">
        {{ include('molshoop/help/season_tests.html.twig') }}
    </div>
</div>
