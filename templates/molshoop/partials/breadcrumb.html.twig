{% macro breadcrumb(items) %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            {% for item in items %}
                {% if loop.last %}
                    <li class="breadcrumb-item active" aria-current="page">{{ item.label }}</li>
                {% else %}
                    <li class="breadcrumb-item"><a href="{{ item.path }}">{{ item.label }}</a></li>
                {% endif %}
            {% endfor %}
        </ol>
    </nav>
{% endmacro %}
