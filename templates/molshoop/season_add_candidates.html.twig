{% extends 'molshoop/base.html.twig' %}

{% import 'molshoop/partials/breadcrumb.html.twig' as breadcrumb %}

{% block breadcrumbs %}
    {{ breadcrumb.breadcrumb([
        {label: 'Home'|trans, path: path('tvdt_molshoop_index')},
        {label: season.name, path: path('tvdt_molshoop_season', {seasonCode: season.seasonCode})},
        {label: 'Add Candidates'|trans},
    ]) }}
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-6 col-12">
            <h2 class="mb-3">{{ 'Add Candidates'|trans }}</h2>
            {{ form_start(form) }}
            {{ form_row(form.candidates) }}
            <button type="submit" class="btn btn-primary">{{ 'Submit'|trans }}</button>
            {{ form_end(form) }}
        </div>
        <div class="col-md-6 col-12">
            {{ include('molshoop/help/season_add_candidates.html.twig') }}
        </div>
    </div>
{% endblock %}

{% block title %}

{% endblock %}
