{% extends 'molshoop/base.html.twig' %}

{% import 'molshoop/partials/breadcrumb.html.twig' as breadcrumb %}

{% block title %}{{ parent() }}{{ 'Molehill'|trans }}{% endblock %}

{% block breadcrumbs %}
    {{ breadcrumb.breadcrumb([
        {label: 'Home'|trans},
    ]) }}
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-8 col-12">
            <div class="d-flex flex-row align-items-center mb-3">
                <h2 class="mb-0 pe-2">
                    {{ is_granted('ROLE_ADMIN') ? 'All Seasons'|trans : 'Your Seasons'|trans }}
                </h2>
                <a class="link" href="{{ path('tvdt_molshoop_season_add') }}">
                    {{ 'Add'|trans }}
                </a>
            </div>
            {% if seasons %}
                <div class="list-group mb-3">
                    {% for season in seasons %}
                        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <a href="{{ path('tvdt_molshoop_season', {seasonCode: season.seasonCode}) }}"
                                   class="stretched-link text-reset text-decoration-none fw-semibold">{{ season.name }}</a>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <div class="text-body-secondary small">
                                        <strong>{{ t('{count, plural, one {Owner} other {Owners}}', {count: season.owners|length})|trans }}:</strong>
                                        {{ season.owners|map(o => o.email)|join(', ') }}
                                    </div>
                                {% endif %}
                                <div class="text-body-secondary small">
                                    <strong>{{ 'Active Quiz'|trans }}:</strong>
                                    {% if season.activeQuiz %}
                                        {{ season.activeQuiz.name }}
                                    {% else %}
                                        {{ 'No active quiz'|trans }}
                                    {% endif %}
                                </div>
                            </div>
                            <span data-controller="bo--copy-link"
                                  class="position-relative z-2"
                                  data-bo--copy-link-url-value="{{ url('tvdt_quiz_enter_name', {seasonCode: season.seasonCode}) }}"
                                  data-bo--copy-link-hint-label-value="{{ 'Copy join link'|trans }}"
                                  data-bo--copy-link-copied-label-value="{{ 'Link copied to clipboard'|trans }}">
                                <span class="badge {{ season.activeQuiz ? 'text-bg-success' : 'text-bg-secondary' }}"
                                      role="button"
                                      tabindex="0"
                                      aria-label="{{ season.seasonCode }}: {{ season.activeQuiz ? 'Copy join link (active season)'|trans : 'Copy join link (inactive season)'|trans }}"
                                      data-bo--copy-link-target="trigger"
                                      data-action="click->bo--copy-link#copy:prevent keydown.enter->bo--copy-link#copy:prevent keydown.space->bo--copy-link#copy:prevent">{{ season.seasonCode }}</span>
                                <span class="visually-hidden" data-bo--copy-link-target="status" aria-live="polite"></span>
                            </span>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                {{ 'You have no seasons yet.'|trans }}
            {% endif %}
        </div>
        <div class="col-md-4 col-12">
            {{ include('molshoop/help/index.html.twig') }}
        </div>
    </div>
{% endblock %}
