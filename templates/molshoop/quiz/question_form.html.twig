{% extends 'molshoop/base.html.twig' %}
{% import 'molshoop/partials/answer_row.html.twig' as macros %}
{% import 'molshoop/partials/breadcrumb.html.twig' as breadcrumb %}

{% block title %}{{ parent() }}{{ 'Edit question'|trans }}{% endblock %}

{% block breadcrumbs %}
    {{ breadcrumb.breadcrumb([
        {label: 'Home'|trans, path: path('tvdt_molshoop_index')},
        {label: season.name, path: path('tvdt_molshoop_season', {seasonCode: season.seasonCode})},
        {label: quiz.name, path: path('tvdt_molshoop_quiz_overview', {seasonCode: season.seasonCode, quiz: quiz.id})},
        {label: 'Edit question'|trans},
    ]) }}
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-6 col-12">
            <h2 class="mb-3">{{ 'Edit question'|trans }}</h2>
            {{ include('molshoop/quiz/_question_form_body.html.twig') }}
        </div>
        <div class="col-md-6 col-12">
            {{ include('molshoop/help/quiz_question_bank_form.html.twig') }}
        </div>
    </div>
{% endblock body %}
